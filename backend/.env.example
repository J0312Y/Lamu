# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=lamu_user
DB_PASSWORD=change-me
DB_NAME=lamu_admin

# ─── Security ─────────────────────────────────────────────────────────────────
API_ACCESS_KEY=change-this-secret-key

# ─── AI Provider (OpenRouter — 1 cle, tous les providers) ─────────────────────
# Creer un compte sur https://openrouter.ai → Dashboard → API Keys
AI_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
AI_CHAT_API_KEY=sk-or-v1-your-openrouter-key-here

# Modeles par use case (OpenRouter model IDs)
# Voir tous les modeles : https://openrouter.ai/models
MODEL_REALTIME=meta-llama/llama-4-scout
MODEL_HELPDESK=openai/gpt-4.1-mini
MODEL_CHAT=google/gemini-2.5-flash
MODEL_REASONING=anthropic/claude-sonnet-4.6
MODEL_EMBEDDINGS=openai/text-embedding-3-small

# ─── STT Provider (optional) ──────────────────────────────────────────────────
# STT_URL=https://api.openai.com/v1/audio/transcriptions
# STT_API_KEY=sk-...

# ─── Auto-updater ─────────────────────────────────────────────────────────────
# Uncomment and set when publishing a new release
# LATEST_VERSION=0.2.0
# APP_BASE_URL=https://cdn.lamuka.com/releases
# RELEASE_NOTES=Bug fixes and performance improvements

# ─── Monitoring alerts ────────────────────────────────────────────────────────
# Email address to receive provider health alerts (defaults to SMTP from address)
# ADMIN_ALERT_EMAIL=admin@yourdomain.com

# ─── Payment Providers ────────────────────────────────────────────────────────
# CinetPay (primary — Mobile Money XAF, Orange, MTN, cartes)
# Créer un compte sur https://cinetpay.com → Dashboard → Intégration
# CINETPAY_API_KEY=your-cinetpay-api-key
# CINETPAY_SITE_ID=your-site-id

# Flutterwave (fallback — cartes, Mobile Money international)
# Créer un compte sur https://flutterwave.com → Settings → API Keys
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx

# URL publique du backend (pour recevoir les webhooks de paiement)
# BACKEND_PUBLIC_URL=https://api.lamuka-tech.com

# URL de retour après paiement (page du frontend)
# PAYMENT_RETURN_URL=https://app.lamuka-tech.com/payment/callback

# Secret Flutterwave webhook (Settings → Webhooks → Secret Hash)
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# ─── OAuth Integrations ──────────────────────────────────────────────────────
# Google Drive OAuth (https://console.cloud.google.com → APIs → Credentials)
# Redirect URI: {BACKEND_PUBLIC_URL}/api/oauth/google/callback
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Slack OAuth (https://api.slack.com/apps → OAuth & Permissions)
# Redirect URI: {BACKEND_PUBLIC_URL}/api/oauth/slack/callback
# SLACK_CLIENT_ID=xxxxx
# SLACK_CLIENT_SECRET=xxxxx

# GitHub OAuth (https://github.com/settings/developers → OAuth Apps)
# Redirect URI: {BACKEND_PUBLIC_URL}/api/oauth/github/callback
# GITHUB_OAUTH_CLIENT_ID=xxxxx
# GITHUB_OAUTH_CLIENT_SECRET=xxxxx

# GitLab: pas d'OAuth nécessaire — l'utilisateur colle son Personal Access Token
# Créer sur: https://gitlab.com/-/user_settings/personal_access_tokens
